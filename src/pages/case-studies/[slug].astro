---
//@ts-nocheck
import { getCaseStudies } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import SectionHeading from "@components/SectionHeading.astro";
import Section from "@components/Section.astro";
import Button from "@components/Button.astro";

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();

  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
const { caseName, category, date, image, buttonLabel } = caseStudy.caseDetails;
---

<Layout>
  <SectionHeading
    preheader="CASE STUDIES"
    header={caseName}
    text="Our achievements reflect the close collaboration between our expert teams and our esteemed clientele. We cultivate a workplace that champions peak performance and guarantees client satisfaction."
    direction="left"
  />
  <Section>
    <article class="case-story-article">
      <header>
        <Image
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
        />

        <div class="case-details">
          <dl>
            <div>
              <dt>Case Name</dt>
              <dd>{caseName}</dd>
            </div>
            <div>
              <dt>Category</dt>
              <dd class="category">{category}</dd>
            </div>
            <div>
              <dt>Date</dt>
              <dd class="date">{date}</dd>
            </div>
          </dl>
          <Button variant="accent">
            <a href="#0" class="button">{buttonLabel}</a></Button
          >
        </div>
      </header>
      <section class="case-story-content flow">
        {
          caseStudy.sections.map((section, index) => (
            <>
              {index === 0 ? (
                <h2>{section.title}</h2>
              ) : (
                <h3>{section.title}</h3>
              )}

              {Array.isArray(section.content) ? (
                <>
                  {section.content.map((item) => (
                    <p>{item}</p>
                  ))}
                </>
              ) : (
                <p>{section.content}</p>
              )}
              {section.highlights && (
                <ul>
                  {section.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              )}
              {section.image && (
                <figure>
                  <Image
                    src={section.image.src}
                    alt={section.image.alt}
                    width={section.image.width}
                    height={section.image.height}
                  />
                  {section.image.caption && (
                    <figcaption>{section.image.caption}</figcaption>
                  )}
                </figure>
              )}
            </>
          ))
        }
      </section>
    </article>
  </Section>
</Layout>

<style>
  .case-story-article {
    display: grid;
    grid-column: content-start / content-end;
  }

  header img {
    border-radius: var(--card-padding);
  }

  .case-details {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    background-color: black;
    padding: var(--card-padding);
    margin-inline: 7%;
    margin-top: -2.5rem;
    border-radius: var(--general-radius);
    color: white;

    > dl {
      display: flex;
      justify-content: space-between;
      gap: var(--xxl-spacing);
      dt {
        font-size: var(--postheader-size);
        font-weight: var(--all-header-weight);
      }
    }
  }

  .case-story-content {
    margin-top: var(--xxl-spacing);
  }
  .case-story-content > *:not(figure) {
    margin-inline: 16%;
  }

  figure {
    display: grid;
    grid-template-columns: subgrid;

    img {
      grid-row: 1;
      grid-column: content;
    }
    figcaption {
      grid-row: 1;
      align-self: end;
      color: #fff;
      z-index: 2;

      padding-block: 4rlh 1rlh;
      padding-left: 16%;
      background: linear-gradient(180deg, #0000 5%, #000);
    }
  }
</style>
