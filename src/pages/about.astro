---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import Newsletter from "@components/Newsletter.astro";
import Section from "@components/Section.astro";
import Faq from "@components/Faq.astro";
import SectionHeading from "@components/SectionHeading.astro";
---

<Layout>
  <SectionHeading
    preheader="About"
    header="Igniting Innovation"
    text="Our strength lies in the collaboration between our talented teams and esteemed clients. We cultivate a workplace that champions innovation, promotes peak performance, and guarantees client satisfaction."
    direction="right"
  />
  <!-- Byg sidens sektioner her med udgangspunkt i Figma-designet. -->
  <Card header="Overskrift her" text="Her kommer der en masse tekst" />
  <Section
    preheader="WE'LL WORK WITH YOU"
    header="What To Expect"
    text="Our collaboration is built on transparency, efficiency, and measurable results. Together, we create strategies tailored to your unique needs and goals."
    theme="muted"
  >
    <Card header="Overskrift" text="Meget tekst her" />
    <Faq />
  </Section>
</Layout>
