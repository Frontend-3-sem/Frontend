---
import "@styles/main.css";
import { Font } from "astro:assets";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>ASK EXPERTS</title>
    <Font cssVariable="--font-cabin" preload />
    <Font cssVariable="--font-lato" preload />
    <style is:inline>
      @layer reset, global, tokens, components, overrides;
    </style>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @layer global {
    body {
      display: grid;
      grid-template-columns:
        [full-start] 1fr [content]
        minmax(0, 70ch)
        1fr [full-end];

      > * {
        grid-column: full;
      }
    }

    main {
      display: grid;
      grid-template-columns: subgrid;
      > * {
        grid-column: content;
      }
    }

    header,
    footer {
      display: grid;
      grid-template-columns: subgrid;
      > * {
        grid-column: content;
      }
    }
    .hero {
      grid-column: 1 / -1;
      display: grid;
      background: #a8fad5;
      grid-template-columns: subgrid;

      > * {
        grid-column: content;
      }
    }
  }
</style>
