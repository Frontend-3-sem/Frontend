---
import Logo from "./Logo.astro";
import ButtonLogin from "./ButtonLogin.astro";
const currentPath = Astro.url.pathname;
import Button from "./Button.astro";
---

<header>
  <nav>
    <Logo href="/" />
    <ul>
      <li>
        <a href="/" class={currentPath === "/" ? "active" : ""}>Home</a>
      </li>
      <li><a href="">Case Studies</a></li>
      <li>
        <a href="/team/" class={currentPath === "/team/" ? "active" : ""}
          >Team</a
        >
      </li>
      <li>
        <a href="/about" class={currentPath === "/about" ? "active" : ""}
          >About</a
        >
      </li>
    </ul>
    <div class="button-login">
      <ButtonLogin title="Login" id="login">
        <h4>Dashboard Login</h4>
        <form aria-label="login form">
          <label for="email">Email address </label>
          <input type="text" id="email" name="email" />
          <label for="pwd">Password</label>
          <input type="password" id="pwd" name="password" />
          <Button class="inputButton" variant="accent" type="submit"
            >Go to dashboard</Button
          >
        </form>
      </ButtonLogin>
    </div>
  </nav>
</header>

<style>
  header {
    background-color: var(--color-neutrals-900);
    padding: var(--l-spacing);
    ul {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 1.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    ul a {
      text-decoration: none;
      font-weight: 400;
      color: inherit;
      display: inline-block;
      padding-block: 0.75rem;
    }

    ul a:is(:hover, :focus-visible, .active) {
      text-decoration-line: underline;
      text-decoration-color: var(--color-action);
      text-decoration-thickness: 0.25rem;
      text-underline-offset: 0.45rem;
    }
  }

  input {
    border-radius: var(--btn-radius);
    border: #b1b1b1 solid 1px;
    background-color: #ffffff;
    padding: 1rem 1rem;
    margin-bottom: 1.5rem;
  }
  label {
    margin-bottom: 0.3rem;
    font-family: var(--all-headers-font);
  }

  .inputButton {
    justify-content: center;
  }

  nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    column-gap: 2rem;
    align-items: center;
    color: var(--color-neutrals-50);

    > * {
      display: flex;
      gap: 1.25rem;
    }

    > *:nth-child(2) {
      grid-column: 2;
      justify-self: center;
    }

    > :last-child {
      grid-column: 3;
      justify-self: end;
    }

    & li {
      list-style: none;
    }
  }
  @media (width < 30rem) {
    nav {
      grid-template-columns: 1fr auto;
    }
  }

  h4 {
    text-box-trim: trim-start;
    margin: 0 0 2rem;
  }

  form {
    display: grid;
  }

  form > * {
    transition: 0.5s;
    transition-delay: calc(sibling-index() * 0.1s);
    transition-timing-function: linear(
      0,
      0.013 1%,
      0.051 2.2%,
      0.404 9.8%,
      0.51 12.6%,
      0.602 15.5%,
      0.683 18.7%,
      0.754 22.2%,
      0.813 26%,
      0.861 30.2%,
      0.9 34.8%,
      0.931 40%,
      0.972 52.7%,
      0.992 70.2%,
      1
    );
    @starting-style {
      translate 0 2rem;
      opacity: 0;
    }
  }
</style>
