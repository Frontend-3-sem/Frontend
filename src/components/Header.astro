---
import Logo from "./Logo.astro";
import ButtonLogin from "./ButtonLogin.astro";
const currentPath = Astro.url.pathname;
---

<header>
  <nav>
    <Logo />
    <ul>
      <li>
        <a href="/" class={currentPath === "/" ? "active" : ""}>Home</a>
      </li>
      <li><a href="">Case Studies</a></li>
      <li>
        <a href="/team/" class={currentPath === "/team/" ? "active" : ""}
          >Team</a>
      </li>
      <li>
        <a href="/about" class={currentPath === "/about" ? "active" : ""}
          >About</a
        >
      </li>
    </ul>
    <div class="button-login">
      <ButtonLogin title="Login" id="login">
        <div>
          <h2>Dashboard Login</h2>
          <form aria-label="login form">
            <label for="email">Email address </label>
            <input type="text" id="email" name="email" />
            <label for="pwd">Password</label>
            <input type="password" id="pwd" name="password" />
            <button>Go to Dashboard</button>
          </form>
        </div>
      </ButtonLogin>
    </div>
  </nav>
</header>

<style>
  header {
    background-color: var(--color-neutrals-900);
    padding: 2.375rem;
    ul a {
      text-decoration: none;
      font-weight: 400;
      color: inherit;
    }

    ul a.active {
      text-decoration-color: var(--color-action);
      text-underline-offset: 0.45rem;
      text-decoration-thickness: 0.25rem;
      text-decoration-line: underline;
    }
  }

  nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    column-gap: 2rem;
    align-items: center;
    color: var(--color-neutrals-50);

    > * {
      display: flex;
      gap: 1.25rem;
    }

    > *:nth-child(2) {
      grid-column: 2;
      justify-self: center;
    }

    > :last-child {
      grid-column: 3;
      justify-self: end;
    }

    & li {
      list-style: none;
    }
  }

  form {
    display: flex;
    flex-direction: column;
  }
  form > * {
    transition: 0.5s;
    transition-delay: calc(sibling-index() * 0.1s);
    transition-timing-function:;
  }
</style>
