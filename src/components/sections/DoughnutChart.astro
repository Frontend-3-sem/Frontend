---
//@ts-nocheck
import DoughnutSection from "@components/DoughnutSection.astro";
import { getExperience } from "@lib/api";
const ExperienceData = await getExperience();
const { theme = "accent" } = Astro.props;
const { eyebrow, title, subtitle, stats } = ExperienceData;
import Section from "./Section.astro";
import SectionText from "@components/SectionText.astro";
---

<Section theme={theme}>
  <SectionText eyebrow={eyebrow} title={title} subtitle={subtitle} />
  <div class="doughnut">
    {stats.map((stat) => <DoughnutSection {...stat} />)}
  </div>
</Section>

<style>
  .doughnut {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 2rem;
  }
</style>
