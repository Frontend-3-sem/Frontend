---
const { label, value } = Astro.props;
---

<figure data-value={value}>
  <svg viewBox="0 0 100 100">
    <circle cx="50" cy="50" r="48" class="track"></circle>
    <circle cx="50" cy="50" r="48" class="progress" pathLength="100"></circle>
    <circle class="marker" r="4" fill="black" stroke="white"></circle>
  </svg>
  <h6>{label}</h6>
</figure>

<style>
  figure {
    --value-string: attr(data-value);
    --value-number: attr(data-value type(<number>));
    --value-percent: attr(data-value %);
    transition: --progress 1s;
    container: stack / inline-size;
    display: grid;
    grid: "stack";
    place-items: center;
    flex: 0 1 200px;
    min-inline-size: 0;
    text-align: center;
    gap: var(--s-spacing);
    timeline-trigger: --trigger view() entry 100% exit 0%;
    animation-trigger: --trigger play-forwards play-backwards;
  }
  @property --progress {
    syntax: "<integer>";
    inherits: true;
    initial-value: 0;
  }

  figure::after {
    content: var(--value-string) "%";
    grid-area: stack;
    font-size: 25cqw;
    font-weight: 700;
    animation: --count 2s ease-out;
    animation-trigger: --trigger play-forwards play-backwards;
  }
  svg {
    grid-area: stack;
    rotate: z -90deg;
  }
  .track {
    stroke: gainsboro;
  }
  .track,
  .progress {
    cx: 50;
    cy: 50;
    r: 46;
    fill: none;
    stroke-width: 4;
  }
  .progress {
    stroke: white;
    stroke-dasharray: 100.1;
    stroke-dashoffset: calc(100 - var(--value-number));
    stroke-linecap: round;
    animation: --fillmath 2s ease-out;
    animation-trigger: --trigger play-forwards play-backwards;
  }

  .marker {
    visibility: visible;
    r: 4;
    offset-path: circle(46px at 50px 50px);
    offset-distance: var(--value-percent);
    animation: --dottrigger 2s ease-out;
    animation-trigger: --trigger play-forwards play-backwards;
  }

  @keyframes --count {
    from {
      --progress: 0;
    }
  }

  @keyframes --fillmath {
    from {
      stroke-dashoffset: 100;
    }
  }

  @keyframes --dottrigger {
    from {
      offset-distance: 0%;
    }
  }
</style>
