---
import SectionText from "@components/SectionText.astro";
const { theme = "white", ...props } = Astro.props;
---

<section class="baseSection hero" data-theme={theme}>
  <slot />
</section>

<style>
  [data-theme] {
    --surface: attr(data-theme type(muted | accent | dark), primary);
    background: var(--bg-surface, var(--color-surface-primary));
    padding: 5.6rem 0rem;
  }

  [data-theme="dark"] {
    --bg-surface: var(--color-ui-primary);
  }

  [data-theme="accent"] {
    --bg-surface: var(--color-surface-highlight);
  }

  [data-theme="muted"] {
    --bg-surface: var(--color-surface-secondary);
  }
</style>
