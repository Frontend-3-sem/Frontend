---
import ScrollingSection from "./ScrollingSection.astro";

const res = await fetch("https://ftk-api.pages.dev/financial-projections");
const financial = await res.json();
---

<div class="financial">
  <ScrollingSection financial={financial} />
</div>

<style>
  ul {
    list-style: none;
    display: flex;
    grid-column: 1/-1;
    gap: var(--card-gap);
    scroll-behavior: smooth;
    overflow-inline: auto;
    scroll-snap-type: inline mandatory;
    padding-inline: max(1rem, 50% - var(--content-width) / 2);

    > * {
      background-color: var(--card-background);
      padding: var(--card-padding);
      border-radius: var(--card-border-radius);
      color: var(--card-text-color);
      flex: 0 0 min(85%, 24rem);
      scroll-snap-align: center;
    }
  }
</style>
