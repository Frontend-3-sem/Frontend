---
import DynamicIcon from "./helpers/DynamicIcon.astro";
const { title, icon, description } = Astro.props;
---

<article class="scrolling">
  <DynamicIcon name={icon} />
  <h4>{title}</h4>
  <p>{description}</p>
  <h6></h6>
</article>

<style>
  .scrolling {
    background-color: var(--color-neutrals-200);
    padding: var(--l-spacing);
    border-radius: var(--general-radius);
    color: var(--card-text-color);
    flex: 0 0 min(85%, 24rem);
    scroll-snap-align: center;

    > h4 {
      font-size: 1.5rem;
    }

    p {
      color: var(--color-text-muted);
    }
  }
</style>
