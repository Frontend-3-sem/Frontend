---
import DynamicIcon from "@components/helpers/DynamicIcon.astro";
import Arrowright from "@icons/arrow--right.svg";

const { title, icon, description, link } = Astro.props;
---

<article class="card card-layout">
  <div>
    <DynamicIcon name={icon} />
    <h4>{title}</h4>
    <p>{description}</p>
    <a href={link.url}><span><p>{link.text}</p></span><Arrowright /></a>
  </div>
</article>

<style>
  @layer components {
    article {
      flex: 0 0 min(85%, 24rem);
      scroll-snap-align: center;
      a {
        display: inline-flex;
        justify-self: center;
        text-decoration: none;
        color: inherit;
        gap: 1rem;
      }
      p {
        color: var(--color-text-muted);
      }
    }
    .card {
      @container style(--theme: dark) {
        --card-bg: var(--color-surface-secondary);
      }
      @container style(--theme: muted) {
        --card-bg: var(--color-surface-primary);
      }

      background: var(--card-bg, var(--color-surface-primary));
    }
  }
</style>
