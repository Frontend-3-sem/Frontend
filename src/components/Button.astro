---
const { href, name, variant = "primary", ...props } = Astro.props;
import DynamicIcon from "./helpers/DynamicIcon.astro";
---

{
  href ? (
    <a data-variant={variant} {href}>
      <slot />
      <span>
        <DynamicIcon name={name} />
      </span>
    </a>
  ) : (
    <button data-variant={variant} {...props}>
      <slot />
    </button>
  )
}

<style>
  a,
  button {
    padding: var(--btn-padding);
    border-radius: var(--btn-radius);
    border: none;
    text-decoration: none;
    font-weight: var(--semibold-weight);
    font-size: var(--body-max-size);
    display: inline-flex;
    align-items: center;
    gap: var(--xs-spacing);
  }
  [data-variant="primary"] {
    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);
  }

  [data-variant="accent"] {
    background: var(--color-action);
    color: contrast-color(var(--color-action));
  }

  span {
    z-index: 1;
  }
</style>
