---
const {
  titleleft,
  titleright,
  href,
  name,
  variant = "primary",
  ...props
} = Astro.props;
import DynamicIcon from "./helpers/DynamicIcon.astro";
---

{
  href ? (
    <a data-variant={variant} {href}>
      {titleleft}
      <span>
        <DynamicIcon name={name} />
      </span>
      {titleright}
    </a>
  ) : (
    <button data-variant={variant} {...props}>
      <slot />
      <DynamicIcon name={name} />
    </button>
  )
}

<style>
  a,
  button {
    padding: var(--btn-padding);
    border-radius: var(--btn-radius);
    border: none;
    text-decoration: none;
    font-weight: var(--semibold-weight);
    font-size: var(--body-size);
    display: inline-flex;
    align-items: center;
    gap: var(--xs-spacing);
    width: fit-content;
  }
  [data-variant="primary"] {
    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);

    @container style(--surface: dark) {
      background-color: var(--color-on-ui-primary);
      color: var(--color-text);
    }
  }

  [data-variant="accent"] {
    background: var(--color-action);
    color: contrast-color(var(--color-action));
  }

  [data-variant="outline"] {
    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);
    border: solid 1px var(--color-text-muted);
  }

  span {
    z-index: 1;
  }
</style>
