---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import Button from "./Button.astro";
import DynamicIcon from "./helpers/DynamicIcon.astro";
---

<section class="hero">
  <div class="hero-content">
    <h1><span>Empowering</span> Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>
    <div class="btn-wrap">
      <Button variant="accent" href="#0" titleleft="Book a Meeting" />
      <Button
        variant="outline"
        href="#0"
        name="arrow--right"
        titleleft="Learn More"
      />
    </div>
  </div>
  <div class="background"></div>

  <Image src={CEOImage} alt="CEO" />

  <div class="service-wrap">
    <Services />
  </div>
</section>

<style>
  /* Styles her */
  @layer components {
    .hero {
      display: grid;
      grid-template-columns: subgrid;
      grid-template-rows: 1fr auto auto;

      /* padding: 2rem; */
      > :last-child {
        grid-column: content;
        grid-row: 2 / 4;
      }
      > :nth-child(3) {
        grid-column: center / full-end;
        grid-row: 1 / 3;
        place-self: stretch;
        contain: size;
        object-fit: cover;
      }
    }

    .hero-content {
      grid-column: content-start / center;
      grid-row: 1 / 2;
      color: var(--color-on-ui-primary-muted);
      z-index: 3;
      place-self: center left;
      text-wrap: balance;
      padding-top: var(--section-padding);
      h1 {
        --underline: 4px;
        --offset: 8px;
        font-size: var(--h2-size);
        color: var(--color-on-ui-primary);
        text-box: cap alphabetic;
        line-height: 1.2;
        anchor-name: --title;
        &::before {
          content: "";
          position: absolute;
          position-anchor: --title;
          top: calc(anchor(top) + 1cap);
          margin-top: var(--offset);
          height: var(--underline);
          background: linear-gradient(
            to right,
            transparent,
            var(--color-action)
          );
          right: calc(anchor(left) - 1px);
          left: 0;
        }
        span {
          --underline: 4px;
          --offset: 8px;
          text-decoration: underline var(--color-action) var(--underline);
          text-underline-offset: var(--offset);
        }
      }
      p {
        margin-top: var(--s-spacing);
        margin-bottom: var(--l-spacing);
      }
    }

    .btn-wrap {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-spacing);
      /* .border a {
        border: solid 1px red;
      } */
      margin-bottom: var(--xl-spacing);
    }

    .service-wrap {
      grid-column: content;
    }

    .background {
      grid-column: full;
      grid-row: 1 / 3;
      --pattern-color: var(--color-text-muted);

      background:
        radial-gradient(
          ellipse farthest-side at 65% 35%,
          #0000,
          var(--color-ui-primary)
        ),
        conic-gradient(
            from 180deg at 1px 1px,
            rgb(from var(--pattern-color) r g b / 0.35) 75%,
            #0000 0
          ) -1px -1px /
          50px 50px,
        var(--color-ui-primary);
    }
  }

  span {
    width: 1rem;
  }
</style>
