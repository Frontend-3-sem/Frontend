---
const { preheader, header, text, direction = "left" } = Astro.props;
---

<section>
  <div>
    <p class="pre">{preheader}</p>
    <h1 data-direction={direction}>{header}</h1>
    <p>{text}</p>
  </div>
</section>

<style>
  section {
    padding-block: var(--xxl-spacing);
    background: var(--color-surface-secondary);
  }
  div {
    place-items: center;
    text-align: center;
  }
  p {
    max-width: 65ch;
    font-size: var(--postheader-size);
    color: var(--color-text-muted);
  }
  h1 {
    --underline: 4px;
    --offset: 8px;
    text-decoration: underline var(--color-action) var(--underline);
    text-underline-offset: var(--offset);
    anchor-name: --title;
    text-box: cap alphabetic;
    width: fit-content;
    &::before {
      content: "";
      position: absolute;
      position-anchor: --title;
      top: calc(anchor(bottom));
      margin-top: var(--offset);
      height: var(--underline);
      background: var(--color-action);
    }
    &[data-direction="left"]::before {
      right: calc(anchor(left) - 1px);
      left: 0;
    }
    &[data-direction="right"]::before {
      left: calc(anchor(right) - 1px);
      right: 0;
    }
  }
</style>
