---
const { service } = Astro.props;
import ArrowRight from "@icons/arrow--right.svg";
---

<article>
  <h6>{service.title}</h6>
  <p>{service.description}</p>
  <a href="#0">{service.buttonText} <ArrowRight stroke-width={2.5} /></a>
</article>

<style>
  @layer components {
    article {
      background: var(--color-blue-700-transparent);
      color: var(--color-on-surface-elevated);
      padding: var(--card-padding);
      border-radius: var(--general-radius);
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      row-gap: var(--xs-spacing);
    }
    a {
      display: inline flex;
      gap: 1ch;
      color: var(--color-action);
      font-weight: bold;

      svg {
        inline-size: 16px;
      }
    }
  }
</style>
