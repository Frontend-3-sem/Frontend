---
//@ts-nocheck
import { getValue } from "@lib/api";
import Section from "@components/Section.astro";
import SectionText from "@components/SectionText.astro";
import CoreValueCard from "./CoreValueCard.astro";
const { theme = "dark" } = Astro.props;
const ValueData = await getValue();
const { title, subtitle, eyebrow, values } = ValueData;
---

<Section theme={theme}>
  <SectionText title={title} subtitle={subtitle} eyebrow={eyebrow} />
  <div class="CoreValue">
    {values.map((card) => <CoreValueCard {...card} />)}
  </div>
</Section>

<style>
  .CoreValue {
    display: flex;
    grid-column: 1/-1;
    gap: var(--m-spacing);
    scroll-behavior: smooth;
    overflow-inline: auto;
    scroll-snap-type: inline mandatory;
    padding-inline: max(1rem, 50% - var(--max-content) / 2);
    margin-block-end: 5.6rem;
  }
</style>
