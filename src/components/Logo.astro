---
const { href } = Astro.props;
---

<a {href}> <span data-variant={href}>Ask</span></a>

<style>
  a {
    text-decoration: none;
  }
  span {
    font-weight: 600;
    font-size: 1.875rem;
    color: var(--color-on-ui-primary);
  }

  span::after {
    content: "Experts";
    color: var(--color-action);
  }
</style>
