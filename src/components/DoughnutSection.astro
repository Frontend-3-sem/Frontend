---
const { label, value } = Astro.props;
---

<figure data-value={value} scroll-trigger>
  <svg viewBox="0 0 100 100">
    <circle cx="50" cy="50" r="48" class="track"></circle>
    <circle cx="50" cy="50" r="48" class="progress" pathLength="100"></circle>
    <circle class="marker" r="4" fill="black" stroke="white"></circle>
  </svg>
  <h6>{label}</h6>
</figure>

<style>
  [scroll-trigger] {
    --transition-duration: 1s;
    animation: --switch linear both;
    animation-timeline: view();
    animation-range: 12.5% 25%;

    > * {
      transition: var(--transition-duration) --progress ease;
    }
  }

  @keyframes --switch {
    to {
      --progress: 1;
    }
  }
  @property --progress {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }
  figure {
    --value-string: attr(data-value);
    --value-number: attr(data-value type(<number>));
    --value-percent: calc(var(--progress) * 1%);
    transition: --progress 1s;
    container: stack / inline-size;
    display: grid;
    grid: "stack";
    place-items: center;
    flex: 0 1 200px;
    min-inline-size: 0;
    text-align: center;
    gap: var(--s-spacing);

    &::before {
      counter-reset: value round(var(--progress));
      /* content: var(--value-string) "%"; */
      content: counter(value, decimal-leading-zero) "%";
      grid-area: stack;
      font-size: 30cqw;
      font-variant-numeric: tabular-nums;
      font-feature-settings: "tnum";
    }
  }

  svg {
    grid-area: stack;
    rotate: z -90deg;
  }
  .track {
    stroke: gainsboro;
  }
  .track,
  .progress {
    cx: 50;
    cy: 50;
    r: 46;
    fill: none;
    stroke-width: 4;
  }
  .progress {
    stroke: white;
    stroke-dasharray: 100.1;
    stroke-dashoffset: calc(100 - var(--progress));
    stroke-linecap: round;
  }
  .marker {
    offset-path: circle(46px at 50px 50px);
    offset-distance: var(--value-percent);
  }

  /* figure {
    animation: --frames 1s linear;
    timeline-trigger: --a view() entry 100% exit 0% / cover;
    animation-trigger: --a play-forwards reset;

    rotate: calc(var(--s) * 360deg);
    transition: rotate 0.4s;
  }

  @keyframes --frames {
    to {
      rotate: 1turn;
      --s: 1;
    }
  } */
</style>
