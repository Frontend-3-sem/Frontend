---
import Section from "@components/Section.astro";
import GreenBox from "@components/GreenBox.astro";
import ExpectImage from "@assets/images/whattoexpect.webp";
import { Image } from "astro:assets";
import SectionText from "@components/SectionText.astro";
import Checkmark from "@icons/checkmark.svg";
---

<Section>
  <div class="grid">
    <div class="expect-wrapper">
      <GreenBox width="11rem" height="10rem" location="top-left">
        <Image src={ExpectImage} alt="Expectimg" />
      </GreenBox>
      <div class="text-content">
        <SectionText
          eyebrow="WE'LL WORK WITH YOU"
          title="What to Expect"
          subtitle="Our collaboration is built on transparency, efficiency, and measurable results. Together, we create strategies tailored to your unique needs and goals."
        />
        <ul>
          <li>
            <Checkmark width={22} height={22} class="checkmark" />
            Collaborate to build actionable strategies that drive sustainable growth
            and deliver tangible outcomes.
          </li>
          <li>
            <Checkmark width={22} height={22} class="checkmark" />
            Identify opportunities to optimize processes and implement impactful solutions
            with measurable results.
          </li>
        </ul>
      </div>
    </div>
  </div>
</Section>

<style>
  @layer components {
    .grid {
      container: expect / inline-size;
    }
  }

  .expect-wrapper {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--xl-spacing);
  }

  @container expect (width < 650px) {
    .expect-wrapper {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .text-content {
      order: -1;
    }
  }

  .checkmark {
    color: var(--color-ui-secondary-alternative);
    flex-shrink: 0;
  }

  img {
    border-radius: 1rem;
    align-self: stretch;
    object-fit: cover;
  }

  ul {
    display: flex;
    flex-direction: column;
    padding: 0;
    gap: var(--s-spacing);
    list-style: none;

    > li {
      display: flex;
      align-items: flex-start;
      gap: var(--m-spacing);
    }
  }
</style>
