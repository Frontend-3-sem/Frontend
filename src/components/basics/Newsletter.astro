---
import Button from "./Button.astro";
---

<section>
  <div>
    <p>STAY UPDATED</p>
    <h5>Subscribe To Our Newsletter</h5>
    <p>Build stronger Customer Relationships with <span>Consultalk</span></p>
    <form>
      <input type="email" placeholder="your mail address" />
      <Button variant="accent">Subscribe</Button>
    </form>
  </div>
</section>

<style>
  section {
    background-color: var(--color-ui-primary);
    display: grid;
    grid-template-columns: subgrid;
    grid-column: full;
    > * {
      grid-column: content;
    }
    padding: var(--xxl-spacing);
  }
  div {
    justify-items: center;
    p:first-of-type {
      color: var(--color-action);
      font-size: var(--pre-header-max-size);
      letter-spacing: var(--pre-header-letter-spacing);
    }
    h5 {
      font-size: var(--h5-max-size);
      margin: 0;
      color: var(--color-on-ui-primary);
      margin: var(--s-spacing);
    }
    p {
      color: var(--color-text-muted);
      span {
        color: var(--color-action);
      }
    }
  }

  input {
    border-radius: var(--btn-radius);
    border: 1px solid var(--color-text-weak);
    flex-grow: 1;
    padding-left: var(--l-spacing);
  }
  form {
    height: fit-content;
    display: flex;
    gap: var(--s-spacing);
    margin-top: var(--l-spacing);
  }
</style>
