---
const { eyebrow, title, subtitle } = Astro.props;
---

<article class="sectText">
  <h5 class="pre">{eyebrow}</h5>
  <h3>{title}</h3>
  <p>{subtitle}</p>
</article>

<style>
  @layer components {
    .sectText {
      grid-column: content-start / center;
      > :nth-child(2) {
        margin-block: var(--s-spacing);
        text-box: trim-both cap alphabetic;
      }
      > :last-child {
        margin-bottom: var(--m-spacing);
      }
    }
    h5 {
      text-box: trim-start cap alphabetic;
      margin: 0;
    }
    .sectText {
      @container style(--surface: dark) {
        --section-text: var(--color-on-ui-primary);
      }
      @container style(--surface: muted) {
        --section-text: var(--color-text);
      }

      color: var(--section-text, var(--color-text));
    }
  }
</style>
