---
//@ts-nocheck
import Section from "@components/Section.astro";

const FaqData = await fetch("https://ftk-api.pages.dev/faq").then((res) =>
  res.json(),
);
---

<Section>
  <div class="faq-wrapper">
    <div class="preheader">
      <h5 class="pre">Faq</h5>
      <h2>Customer Questions</h2>
    </div>
    <div class="faq">
      {
        FaqData.map((faq) => (
          <details name="faq">
            <summary>
              <h4>{faq.question}</h4>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</Section>
<style>
  .preheader {
    text-align: center;
  }
  details {
    border-block-end: 2px solid #dadada;
    padding-block: 1rem;
    cursor: pointer;
  }
  h4 {
    font-size: var(--postheader-size);
  }

  p {
    color: var(--color-text-muted);
  }

  summary {
    position: relative;
    anchor-name: --summary;
    &::marker {
      content: "";
    }

    &::before,
    &::after {
      content: "";
      border-block-start: 2px solid #181818;
      height: 0;
      width: 1rem;
      inset-block-start: 50%;
      inset-inline-end: 0;
      position: absolute;
      position-anchor: --summary;
    }

    &::after {
      transform: rotate(90deg);
      transform-origin: 50%;
    }
  }

  details[open] summary::after {
    transform: rotate(0deg);
  }

  /*   summary::marker {
    content: none;
  }

  summary::after {
    content: "+";
  }

  [open] summary::after {
    content: "-";
  } */
</style>
